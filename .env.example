# Copy this file to .env (local development only). Production uses Render's env vars.
# --- Database ---
# Leave empty to use local SQLite (jobcards.db)
# For PostgreSQL (production), set to your connection string, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/jobcards
DATABASE_URL=

# --- Security ---
# Set a fixed random string in production (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# First admin account (created automatically on first boot if no users exist).
# If ADMIN_PASSWORD is not set, a random one is generated and printed to the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- App ---
# "true" enables debug mode locally
FLASK_DEBUG=true
PORT=5000

# --- Uploads ---
# Leave empty to store uploads in static/uploads. Set an absolute path in production.
UPLOAD_FOLDER=
